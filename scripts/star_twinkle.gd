@export var max_alpha: float = 0.38    ## Насколько ярче звезда в самый яркий момент (0..1)
@export var speed_min: float = 0.35    ## Самая медленная скорость мерцания
@export var speed_max: float = 1.5     ## Самая быстрая скорость мерцания

var count: int = 0
var phase: PackedFloat32Array = PackedFloat32Array()
var speed: PackedFloat32Array = PackedFloat32Array()
var amp: PackedFloat32Array = PackedFloat32Array()
var radius: PackedFloat32Array = PackedFloat32Array()
var glow: Texture2D
var time: float = 0.0


func _ready() -> void:
	var mat := CanvasItemMaterial.new()
	mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	material = mat
	var g := Gradient.new()
	g.offsets = PackedFloat32Array([0.0, 0.3, 1.0])
	g.colors = PackedColorArray([Color(1, 1, 1, 1), Color(1, 1, 1, 0.25), Color(1, 1, 1, 0)])
	var t := GradientTexture2D.new()
	t.gradient = g
	t.fill = GradientTexture2D.FILL_RADIAL
	t.fill_from = Vector2(0.5, 0.5)
	t.fill_to = Vector2(1.0, 0.5)
	t.width = 32
	t.height = 32
	glow = t
	count = POINTS.size() / 2
	var rng := RandomNumberGenerator.new()
	rng.seed = 7
	for i in count:
		phase.append(rng.randf() * TAU)
		speed.append(rng.randf_range(speed_min, speed_max))
		amp.append(rng.randf_range(0.25, 1.0))       # одни звёзды мерцают заметнее, другие еле-еле
		radius.append(rng.randf_range(2.2, 3.6))


func _process(delta: float) -> void:
	time += delta
	queue_redraw()


func _draw() -> void:
	for i in count:
		var p := Vector2(POINTS[i * 2], POINTS[i * 2 + 1])
		var s: float = 0.5 + 0.5 * sin(time * speed[i] + phase[i])
		s = lerpf(s, 0.5 + 0.5 * sin(time * speed[i] * 2.3 + phase[i] * 1.7), 0.3)
		var a: float = max_alpha * amp[i] * s
		var r: float = radius[i]
		draw_texture_rect(glow, Rect2(p - Vector2(r, r), Vector2(r, r) * 2.0), false, Color(0.88, 0.92, 1.0, a))

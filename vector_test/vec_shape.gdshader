shader_type canvas_item;
// Сглаживание краёв векторных фигур. У каждой фигуры по краю идёт узкая кайма:
// внутренний ряд вершин непрозрачный, внешний прозрачный. Здесь кайма растягивается
// ровно на один пиксель экрана при любом размере фигуры, поэтому край остаётся
// чётким и на маленькой кошке, и на крупном плане, и на 4K.

uniform float feather = 1.0;   // ширина каймы в пикселях экрана (0 — сглаживание выключено)

void vertex() {
	// Сколько пикселей экрана приходится на одну единицу рисунка.
	mat4 m = CANVAS_MATRIX * MODEL_MATRIX;
	vec2 ax = (m * vec4(1.0, 0.0, 0.0, 0.0)).xy;
	vec2 ay = (m * vec4(0.0, 1.0, 0.0, 0.0)).xy;
	float px_per_unit = sqrt(0.5 * (dot(ax, ax) + dot(ay, ay)));
	// В UV лежит направление «наружу» от края. Непрозрачные вершины сдвигаются
	// на полпикселя внутрь, прозрачные — на полпикселя наружу.
	VERTEX += UV * (0.5 - COLOR.a) * feather / max(px_per_unit, 0.00001);
}
